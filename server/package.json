{
  "name": "capc-sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run test/postgres.integration.test.ts",
    "migrate": "tsx src/migrate.ts up",
    "migrate:rollback": "tsx src/migrate.ts down",
    "migrate:verify-rollback": "tsx src/verify_rollback.ts",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
